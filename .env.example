# Copy to .env and fill in. env vars win over .env.

# REQUIRED — your Filament MCP agent API key (the fmcp_ token).
FILAMENT_CONNECT_TOKEN=fmcp_...

# Optional — agent API base URL override.
# FILAMENT_AGENT_API_BASE_URL=https://api.filament.dm/mcp/agents

# How your session responds isn't configured here — that's your agent's job
# (e.g. .claude/skills/filament-agent for Claude Code). The tailer just
# registers + writes the inbox.

# Optional — Firebase project (public defaults baked in; only set these if
# Filament's Firebase project changes).
# FILAMENT_FIREBASE_PROJECT_ID=
# FILAMENT_FIREBASE_APP_ID=
# FILAMENT_FIREBASE_API_KEY=
# FILAMENT_FIREBASE_SENDER_ID=
