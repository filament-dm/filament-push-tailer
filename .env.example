# Copy to .env and fill in. env vars win over .env.

# REQUIRED — the fmcp_ connect token from the Filament app connect flow,
# and your homeserver.
FILAMENT_CONNECT_TOKEN=fmcp_...
FILAMENT_HOMESERVER=https://api.filament.dm

# Optional — the woken claude's behaviour.
# Tool allow-list passed to `claude -p` (Filament tools only by default).
FILAMENT_ALLOWED_TOOLS=mcp__filament__*
# Extra system prompt appended for the woken claude (its persona / rules).
# FILAMENT_SYSTEM_PROMPT=You are Gnomington, terse and a little wry.
# Model alias for the woken claude (defaults to your claude's default).
# FILAMENT_CLAUDE_MODEL=claude-opus-4-8

# Optional — push platform + Firebase project (public defaults baked in;
# only set these if Filament's Firebase project changes).
FILAMENT_PUSH_PLATFORM=android
# FILAMENT_FIREBASE_PROJECT_ID=
# FILAMENT_FIREBASE_APP_ID=
# FILAMENT_FIREBASE_API_KEY=
# FILAMENT_FIREBASE_SENDER_ID=
